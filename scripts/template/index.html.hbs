<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{titleCase name}} Demo</title>
  <style>
    html,
    body {
      height: 100%;
    }

    body {
      margin: 0;
      overflow: hidden;
    }
  </style>
</head>
<body>
{{#ifEq type 'Theme'}}
<div id="container"></div>
{{else}}
<video id="player" class="pillarbox-js" controls muted></video>
{{/ifEq}}

<script type="module">
{{#ifEq type 'Theme'}}
  import pillarbox from '@srgssr/pillarbox-web';
  import './scss/{{kebabCase name}}.scss';
  import {{properCase name}} from './src/{{kebabCase name}}.js';
{{else}}
  import '@srgssr/pillarbox-web/dist/pillarbox.min.css';
  import pillarbox from '@srgssr/pillarbox-web';{{#if wantScss}}
  import './scss/{{kebabCase name}}.scss';{{/if}}
  import './src/{{kebabCase name}}.js';
{{/ifEq}}

  // Handle URL parameters
  const searchParams = new URLSearchParams(location.search);
  const debug = searchParams.has('debug');
  const ilHost = searchParams.get('ilHost') || undefined;
  const language = searchParams.get('language');
  const urn = searchParams.get('urn') || 'urn:rts:video:14683290';
{{#ifEq type 'Theme'}}
  const audioOnlyMode = searchParams.has('audioOnlyMode');

  // An audio media is played from an audio element, which gets the audio layout
  const element = document.createElement(urn.includes(':audio:') ? 'audio' : 'video');

  element.id = 'player';
  element.className = '{{kebabCase name}}';
  element.controls = true;
  element.muted = true;
  document.querySelector('#container').replaceWith(element);

  // Create a pillarbox player instance styled by the {{properCase name}} theme
  // The audio only mode is a single bar as wide as the page
  window.player = pillarbox('player', pillarbox.obj.merge({{properCase name}}.options, {
    debug,
    language,
    audioOnlyMode,
    fluid: audioOnlyMode,
    srgOptions: {
      dataProviderHost: ilHost
    }
  }));
{{else}}

  // Create a pillarbox player instance with the {{properCase name}} enabled
  window.player = pillarbox('player', {
    debug,
    language,
    srgOptions: {
      dataProviderHost: ilHost
    },
{{#ifEq type 'Plugin'}}
    plugins: { {{camelCase name}}: true }
{{else}}
    {{camelCase name}}: true
{{/ifEq}}
  });
{{/ifEq}}

  // Load the video source for the player
  player.src({
    src: urn,
    type: 'srgssr/urn',
    disableTrackers: true
  });

  // Expose player for debugging
  window.player = player;
  window.pillarbox = pillarbox;
</script>
</body>
</html>
