import { afterEach, beforeAll, beforeEach, describe, expect, it } from 'vitest';
import {{platform}} from '{{importAlias}}';
import {{properCase name}} from '../src/{{kebabCase name}}.js';
{{#ifEq type 'Theme'}}
import options from '../src/player-options.js';
{{/ifEq}}

window.HTMLMediaElement.prototype.load = () => {};

describe('{{properCase name}}', () => {
  let player, videoElement;

  beforeAll(() => {
    document.body.innerHTML = '<video id="test-video" class="{{#ifEq type 'Theme'}}{{kebabCase name}}{{else}}video-js{{/ifEq}}"></video>';
    videoElement = document.querySelector('#test-video');
  });

  beforeEach(() => {
{{#ifEq type 'Theme'}}
    player = {{platform}}(videoElement, {{properCase name}}.options);
{{else}}
{{#ifEq type 'Plugin'}}
    player = {{platform}}(videoElement, {
      plugins: {
        {{camelCase name}}: true
      }
    });
{{else}}
    player = {{platform}}(videoElement, {
      {{camelCase name}}: true
    });
{{/ifEq}}
{{/ifEq}}
  });

  afterEach(() => {
    player.dispose();
  });

{{#ifEq type 'Theme'}}
  it('should create a player with the theme options', () => {
    expect(player.options()).toMatchObject(options);
    expect({{properCase name}}.options).toBe(options);
    expect({{properCase name}}.VERSION).toBeDefined();
  });
{{else}}
  it('should be registered and attached to the player', () => {
{{#ifEq type 'Plugin'}}
    expect({{platform}}.getPlugin('{{camelCase name}}')).toBe({{properCase name}});
{{else}}
    expect({{platform}}.getComponent('{{properCase name}}')).toBe({{properCase name}});
{{/ifEq}}
    expect(player.{{camelCase name}}).toBeDefined();
    expect({{properCase name}}.VERSION).toBeDefined();
  });
{{/ifEq}}
});
