{
  "name": "@srgssr/srg-ssr-theme",
  "description": "The SRG SSR theme for the Pillarbox player",
  "version": "0.0.1",
  "license": "MIT",
  "author": "SRG SSR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SRGSSR/pillarbox-web-suite.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/SRGSSR/pillarbox-web-suite/tree/main/packages/srg-ssr-theme#readme",
  "type": "module",
  "main": "dist/srg-ssr-theme.cjs",
  "browser": "dist/srg-ssr-theme.umd.min.js",
  "module": "dist/srg-ssr-theme.js",
  "style": "./dist/srg-ssr-theme.min.css",
  "exports": {
    ".": {
      "import": "./dist/srg-ssr-theme.js",
      "require": "./dist/srg-ssr-theme.cjs"
    },
    "./*": "./*"
  },
  "files": [
    "assets/*",
    "dist/*",
    "scss/*"
  ],
  "keywords": [
    "video.js",
    "player",
    "pillarbox",
    "pillarbox-theme",
    "theme",
    "srgssr"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm-run-all clean build:*",
    "build:css": "sass ./scss/srg-ssr-theme.scss:dist/srg-ssr-theme.min.css --style compressed --source-map --load-path node_modules --load-path ../../node_modules",
    "build:lib": "vite build --config vite.config.lib.js",
    "build:umd": "vite build --config vite.config.umd.js",
    "github:page": "vite build",
    "release:ci": "semantic-release",
    "start": " vite --port 4200 --open",
    "test": "vitest run --silent --coverage --coverage.reporter text"
  },
  "dependencies": {
    "@srgssr/airplay-button": "^1.1.4",
    "@srgssr/google-cast-sender": "^1.2.9",
    "@srgssr/live-dvr-time-display": "^1.0.1",
    "@srgssr/srg-ssr-hotkeys": "^1.1.1",
    "@srgssr/user-preferences": "^2.0.1"
  },
  "peerDependencies": {
    "video.js": "^8.0.0"
  },
  "devDependencies": {
    "@srgssr/pillarbox-web": "^1.40.1"
  }
}
